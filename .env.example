# MediShield AI: Environment Configuration Template
# Copy this file to .env and populate with secure deployment values

# Application Security
MEDISHIELD_SECRET_KEY=change-this-to-a-cryptographically-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Administrative Accounts (Generated upon initial database seeding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password
PHARMACIST_USERNAME=pharmacist
PHARMACIST_PASSWORD=change-me-to-a-secure-password

# RAG & LLM Configuration
DISABLE_EXTERNAL_LLM=true
LLM_PROVIDER=local_extractive_grounded
OPENAI_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
